{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KingsCode canonical legal passage v0.5",
  "type": "object",
  "required": [
    "passage_id",
    "doc_id",
    "source_type",
    "title",
    "norm_name",
    "article",
    "retrieval_eligible",
    "text",
    "source_url",
    "order_index",
    "hierarchy_path",
    "graph_node_ids",
    "source_sha256",
    "retrieved_at"
  ],
  "properties": {
    "retrieval_eligible": {"type": "boolean"},
    "index_exclusion_reasons": {"type": "array", "items": {"type": "string"}},
    "passage_id": {
      "type": "string"
    },
    "doc_id": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "constitution",
        "law",
        "decree",
        "code",
        "decision",
        "doctrine",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "norm_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "norm_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "court": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "article": {
      "type": [
        "string",
        "null"
      ]
    },
    "paragraph": {
      "type": [
        "string",
        "null"
      ]
    },
    "clause": {
      "type": [
        "string",
        "null"
      ]
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "hierarchy_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string"
    },
    "source_domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "graph_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order_index": {
      "type": "integer",
      "minimum": 0
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_current_text": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_document_id": {
      "type": ["string", "null"],
      "description": "v0.6 derived: stable id for the legal work, independent of source_url."
    },
    "canonical_fragment_id": {
      "type": ["string", "null"],
      "description": "v0.6 derived: stable id for the fragment within its work; separate namespace from the document id."
    },
    "content_hash": {
      "type": ["string", "null"],
      "description": "v0.6 derived: hash of the semantic body only (text_prefix excluded). Technical field; never part of embedding text."
    },
    "status_assertion": {
      "enum": ["current", "historical", "repealed", "modified", "unknown", null],
      "description": "v0.6 temporal state; defaults to unknown unless the source carries explicit evidence."
    },
    "status_source_passage_id": {"type": ["string", "null"]},
    "effective_from": {"type": ["string", "null"]},
    "effective_to": {"type": ["string", "null"]},
    "version_date": {"type": ["string", "null"]},
    "metadata_version": {"type": ["string", "null"]}
  },
  "additionalProperties": true,
  "x-v0.6-notes": "All v0.6 canonical/temporal fields are OPTIONAL and additive. They are derived deterministically by kingscode.metadata from existing fields and do not change the required Corpus v0.1 contract. Runtime retrieval scores (bm25_score, dense_score, rrf_score, reranker_score, graph_score, final_score) are NOT persistent corpus metadata and must not be stored on passages."
}
