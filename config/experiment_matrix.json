{
  "version": "gate2-prep-v1",
  "query_normalization": "legal-query-v1",
  "k_metrics": 10,
  "k_evidence": 8,
  "candidate_k": 30,
  "graph_budget": 10,
  "retrieval": {
    "R0": {
      "mode": "bm25",
      "rerank": false,
      "graph_mode": "off"
    },
    "R1": {
      "mode": "dense",
      "rerank": false,
      "graph_mode": "off"
    },
    "R2": {
      "mode": "hybrid",
      "rerank": false,
      "graph_mode": "off"
    },
    "R3": {
      "mode": "hybrid",
      "rerank": true,
      "graph_mode": "off"
    },
    "R4": {
      "mode": "hybrid",
      "rerank": true,
      "graph_mode": "auto"
    },
    "R5": {
      "mode": "hybrid",
      "rerank": true,
      "graph_mode": "on"
    }
  },
  "retrieval_metadata_experiments": {
    "owner": "member_a",
    "status": "optional_prepared_ablation",
    "base": "R3",
    "note": "Member A metadata-aware experiments. Layered on the public retrieve() API via kingscode.metadata_experiments; they never replace R0-R5 nor change the default retrieval path. Metadata features are optional soft priors over a candidate union, never hard filters. Runnable on CPU in bm25 mode; neural (hybrid+rerank) variants are prepared for the target GPU only.",
    "R6": {
      "definition": "R3 + exact legal locator / metadata features (candidate union, soft re-rank)",
      "runner": "kingscode.metadata_experiments.run_r6",
      "features": ["exact_norm_match", "exact_article_match", "same_document", "source_type_match", "temporal_match", "graph_distance"],
      "hard_filter": false
    },
    "R7": {
      "definition": "document-first -> passage retrieval",
      "runner": "kingscode.metadata_experiments.run_r7",
      "hard_filter": false
    },
    "R8": {
      "definition": "R3 + diversification (collapse content mirrors, then diversify by canonical document)",
      "runner": "kingscode.metadata_experiments.run_r8",
      "diversification_default": "off_unless_measured"
    }
  },
  "benchmark_v1": {
    "status": "implemented_audited_no_selection",
    "manifest": "benchmarks/kingscode_ir/manifests/benchmark_manifest.json",
    "audit": "reports/benchmark/audit/independent_review.json",
    "split": {"dev": 120, "validation": 40, "holdout": 40},
    "primary_metric": "Evidence Completeness@8",
    "secondary_metrics": ["Recall@10", "nDCG@10", "MRR@10"],
    "selection_policy": "validation_only_then_one_post_selection_holdout_confirmation_then_official50_confirmation; no weighted composite; Pareto frontier when inconclusive",
    "r0": {"mode": "bm25", "rerank": false, "graph_mode": "off", "status": "measured_baseline_not_selected"},
    "cpu_diagnostics": {"status": "diagnostic_only_not_selection_eligible", "variants": ["R0-GRAPH-AUTO-DIAGNOSTIC", "R0-GRAPH-ON-DIAGNOSTIC", "R6-BM25-DIAGNOSTIC", "R7-BM25-DIAGNOSTIC", "R8-BM25-DIAGNOSTIC"]},
    "real_variant_status": "R1-Qwen/R1-BGE/R2/R3-R8 GPU_BLOCKED; do not infer them from diagnostics",
    "freeze_status": "blocked_no_selected_retrieval_configuration",
    "freeze_prerequisites": ["same-ID dense/complementarity", "validation selection", "one post-selection holdout", "official-50 external confirmation without retuning"]
  },
  "decoder": {
    "D1": "qwen3-8b",
    "D2": "alia-legal-7b",
    "D3": "salamandra-7b",
    "D4": "llama31-8b"
  },
  "rule": "Retrieval-only experiments first. Freeze the selected exact evidence, then vary only decoder; precision fallback is a separate experiment."
}
